PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=hard_development
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/hard_development

# JWT Secrets
JWT_SECRET=hard_super_secret_jwt_access_key
JWT_REFRESH_SECRET=hard_super_secret_jwt_refresh_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Ollama AI (Legacy / Optional)
OLLAMA_BASE_URL=http://localhost:11434

# Pinecone Vector Database & Inference
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=hard
PINECONE_EMBED_MODEL=llama-text-embed-v2
PINECONE_EMBED_DIMENSION=1024

# DeepSeek AI Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
