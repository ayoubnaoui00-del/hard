{
  "info": {
    "_postman_id": "hard-sprint3-collection",
    "name": "Hard API - Sprint 3 (Gamification & XP Logging)",
    "description": "Collection for Sprint 3: XP Logging & Leveling System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "XP & Leveling",
      "item": [
        {
          "name": "Get Current User XP Summary (GET /users/me/xp)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me/xp",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "xp"]
            }
          }
        },
        {
          "name": "Get User XP Summary By ID (GET /users/:id/xp)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/xp",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "xp"]
            }
          }
        }
      ]
    }
  ]
}
