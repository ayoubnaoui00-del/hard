{
  "name": "hard-backend",
  "version": "1.0.0",
  "description": "Hard Backend API with Express, Sequelize CLI, and PostgreSQL",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:auth": "node --test tests/auth.test.js",
    "test:sprint2": "node --test tests/sprint2.test.js",
    "test:sprint3": "node --test tests/sprint3.test.js",
    "test:sprint4": "node --test tests/sprint4.test.js",
    "test:agent": "node --test tests/agent.test.js",
    "seed:exercises": "node seeders/seed-exercises.js",
    "seed:achievements": "node seeders/seed-achievements.js",
    "seed:embeddings": "node seeders/seed-embeddings.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.2.2"
  }
}
